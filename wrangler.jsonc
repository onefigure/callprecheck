{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // ─────────────────────────────────────────────────────────────
  // 부르기전에 (CallPrecheck) — Cloudflare Workers 배포 설정
  //
  // 이 사이트는 100% 정적입니다. SSR 어댑터(@astrojs/cloudflare)를 쓰지 않고,
  // Astro 가 만든 dist/ 를 Workers Static Assets 로 그대로 서빙합니다.
  // 그래서 `main`(워커 스크립트)이 없습니다. 정적 자산만 배포되는 구성입니다.
  // ─────────────────────────────────────────────────────────────

  "name": "callprecheck",
  "compatibility_date": "2026-09-12",

  "assets": {
    "directory": "./dist",

    // 이 사이트의 URL 정책은 trailingSlash: 'always' 입니다.
    // /about -> /about/ 으로 리다이렉트해 canonical 과 일치시킵니다.
    "html_handling": "force-trailing-slash",

    // 없는 경로는 dist/404.html 을 404 상태코드로 응답합니다.
    // (SPA 모드가 아니므로 single-page-application 을 쓰지 않습니다.)
    "not_found_handling": "404-page"
  },

  // <name>.<subdomain>.workers.dev 주소로 접속 가능하게 합니다.
  "workers_dev": true,

  // 커밋별 Preview URL(<version>-<name>.<subdomain>.workers.dev)을 활성화합니다.
  "preview_urls": true,

  "observability": {
    "enabled": true
  },

  // 별도의 고정 스테이징 주소가 필요할 때 사용하는 환경입니다.
  // 배포: npm run cf:deploy:staging
  // (브랜치별 자동 미리보기는 아래 versions upload 방식을 씁니다.)
  "env": {
    "staging": {
      "name": "callprecheck-staging",
      "assets": {
        "directory": "./dist",
        "html_handling": "force-trailing-slash",
        "not_found_handling": "404-page"
      },
      "workers_dev": true,
      "preview_urls": true,
      "observability": {
        "enabled": true
      }
    }
  }
}
