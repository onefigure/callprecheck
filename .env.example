# ── 배포 도메인 ───────────────────────────────────────────────
# canonical / sitemap / robots.txt / OG URL 생성 기준값
PUBLIC_SITE_URL=https://callprecheck.com

# ── 문의 메일 주소 ────────────────────────────────────────────
# /contact/ 페이지에서 사용. 실제 수신 가능한 주소로 반드시 교체할 것.
PUBLIC_CONTACT_EMAIL=15991175@naver.com

# ── Google Search Console ────────────────────────────────────
# HTML 메타태그 방식으로 소유권을 확인할 때 content 값만 입력.
# (예: google-site-verification 값) 비워두면 태그가 출력되지 않는다.
PUBLIC_GSC_VERIFICATION=

# ── 네이버 서치어드바이저 ────────────────────────────────────
# HTML 태그 방식으로 소유권을 확인할 때 content 값만 입력.
# (예: naver-site-verification 값) 비워두면 태그가 출력되지 않는다.
PUBLIC_NAVER_VERIFICATION=

# ── 웹 분석 ──────────────────────────────────────────────────
# PUBLIC_ENABLE_ANALYTICS=true 이고 측정 ID가 있을 때만 스크립트를 로드한다.
PUBLIC_ENABLE_ANALYTICS=false
PUBLIC_ANALYTICS_ID=

# ── AdSense (Phase 1에서는 비활성) ───────────────────────────
# 승인 신청 단계에서만 true 로 바꾼다. 빈 광고 영역은 만들지 않는다.
PUBLIC_ENABLE_ADS=false
PUBLIC_ADSENSE_CLIENT=

# 사이트 소유권 확인용 메타태그 값 (예: ca-pub-0000000000000000)
# 광고 스크립트를 로드하지 않고 AdSense 심사 연결만 할 때 사용한다.
# PUBLIC_ENABLE_ADS 와 독립적이므로, 이 값만 넣으면 광고는 나가지 않는다.
PUBLIC_ADSENSE_ACCOUNT=

# ── 임시 주소 운영 (workers.dev 등) ──────────────────────────
# 실제 도메인을 붙이기 전, 임시 주소가 검색엔진에 색인되는 것을 막는다.
# true 면 전 페이지 noindex + robots.txt 전체 차단.
# 실제 도메인으로 옮기면 반드시 false 로 되돌릴 것.
PUBLIC_NOINDEX_ALL=false
