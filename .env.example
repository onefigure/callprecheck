# ── 배포 도메인 ───────────────────────────────────────────────
# canonical / sitemap / robots.txt / OG URL 생성 기준값
PUBLIC_SITE_URL=https://callprecheck.com

# ── 문의 메일 주소 ────────────────────────────────────────────
# /contact/ 페이지에서 사용. 실제 수신 가능한 주소로 반드시 교체할 것.
PUBLIC_CONTACT_EMAIL=contact@callprecheck.com

# ── Google Search Console ────────────────────────────────────
# HTML 메타태그 방식으로 소유권을 확인할 때 content 값만 입력.
# (예: google-site-verification 값) 비워두면 태그가 출력되지 않는다.
PUBLIC_GSC_VERIFICATION=

# ── 웹 분석 ──────────────────────────────────────────────────
# PUBLIC_ENABLE_ANALYTICS=true 이고 측정 ID가 있을 때만 스크립트를 로드한다.
PUBLIC_ENABLE_ANALYTICS=false
PUBLIC_ANALYTICS_ID=

# ── AdSense (Phase 1에서는 비활성) ───────────────────────────
# 승인 신청 단계에서만 true 로 바꾼다. 빈 광고 영역은 만들지 않는다.
PUBLIC_ENABLE_ADS=false
PUBLIC_ADSENSE_CLIENT=
