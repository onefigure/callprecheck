---
import BaseLayout from '../layouts/BaseLayout.astro';
import SymptomPicker from '../components/SymptomPicker.astro';
import QuestionPreview from '../components/QuestionPreview.astro';
import { getCollection } from 'astro:content';
import { PRODUCT_HUBS } from '../data/products';
import { SITE } from '../consts';

// Phase 1 에는 가이드 글이 없으므로 이 목록은 비어 있고,
// "자주 겪는 증상" 섹션 자체가 렌더링되지 않는다. (빈 카드/준비중 카드를 만들지 않기 위함)
const guides = (await getCollection('guides', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.last_reviewed.valueOf() - a.data.last_reviewed.valueOf(),
);

const siteUrl = Astro.site ?? new URL(SITE.url);

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  alternateName: SITE.nameEn,
  url: siteUrl.href,
  inLanguage: 'ko-KR',
  description: SITE.description,
};

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  alternateName: SITE.nameEn,
  url: siteUrl.href,
  logo: new URL('/logo.png', siteUrl).href,
  description:
    '가전제품 고장 증상에서 사용자가 먼저 확인할 항목과 서비스 요청 기준을 정리하는 독립 정보 사이트입니다.',
};

const judgeSteps = [
  {
    title: '먼저 확인할 것',
    body: '전원, 설정, 필터, 배수, 설치환경처럼 사용자가 안전하게 확인할 수 있는 범위를 구분합니다.',
  },
  {
    title: '서비스를 부를 기준',
    body: '자가 확인 범위를 넘어가는 증상과 전문 점검이 필요한 시점을 설명합니다.',
  },
  {
    title: '비용 위험',
    body: '수리비를 확인할 근거가 없을 때는 숫자를 만들지 않고 비용 위험도만 알려드립니다.',
  },
  {
    title: '수리 또는 교체',
    body: '사용 기간, 보증, 부품 수급을 함께 놓고 판단할 수 있게 기준을 정리합니다.',
  },
];

const principles = [
  {
    term: '공식 자료를 먼저 봅니다',
    desc: '제조사 고객지원과 법령·공공기관 자료처럼 주소를 확인할 수 있는 자료를 우선 사용합니다.',
  },
  {
    term: '없는 금액은 만들지 않습니다',
    desc: '확인할 근거가 없는 부품비나 수리비는 적지 않고, 비용 위험도만 표시합니다.',
  },
  {
    term: '확인일을 남깁니다',
    desc: '참고한 자료와 사람이 실제로 확인한 날짜를 각 문서에 함께 표시합니다.',
  },
];
---

<BaseLayout
  title={SITE.tagline}
  description={SITE.description}
  schema={[websiteSchema, organizationSchema]}
>
  <!-- ① Hero + 진단 시작 -->
  <section class="container home-hero">
    <div class="home-hero__grid">
      <div>
        <h1>수리기사 부르기 전, 먼저 확인하세요.</h1>
        <p class="home-hero__lead">
          세탁기·에어컨·냉장고의 증상을 고르면 안전상 주의할 점, 먼저 확인할 항목, AS가 필요한
          기준과 비용 위험을 순서대로 안내합니다.
        </p>

        <SymptomPicker />

        <p class="home-hero__foot">
          <a href="/diagnosis/">진단 도구 전체 화면으로 열기</a>
          <span>회원가입 없이 바로 사용할 수 있습니다.</span>
        </p>
      </div>

      <QuestionPreview />
    </div>
  </section>

  <!-- ② 세탁기 · 에어컨 · 냉장고 -->
  <section class="container section" aria-labelledby="products">
    <h2 id="products">제품별로 확인 범위를 정리했습니다</h2>
    <div class="grid grid--3">
      {
        PRODUCT_HUBS.map((product) => (
          <a class="card card-link" href={product.href}>
            <h3>{product.label}</h3>
            <p class="muted">{product.metaDescription}</p>
          </a>
        ))
      }
    </div>
    <p class="muted" style="margin-top: 1rem">
      <a href="/repair-or-replace/">수리할까 교체할까</a> · <a href="/guides/">가이드 구성 보기</a>
    </p>
  </section>

  <!-- ③ 부르기전에가 판단해주는 4가지 -->
  <section class="container section" aria-labelledby="what-we-do">
    <h2 id="what-we-do">부르기전에가 판단해 드리는 4가지</h2>
    <ol class="steps">
      {
        judgeSteps.map((step, i) => (
          <li>
            <span class="steps__num" aria-hidden="true">
              {i + 1}
            </span>
            <div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ④ 신뢰 원칙 + 안전 -->
  <section class="container section" aria-labelledby="trust">
    <div class="trust-panel">
      <h2 id="trust">정보를 다루는 원칙</h2>
      <p class="muted">
        부르기전에는 특정 제조사나 서비스센터가 운영하는 사이트가 아닙니다. 판단에 필요한 근거를
        어디서 가져왔는지 밝히는 것을 기준으로 삼습니다.
      </p>

      <dl class="trust-list">
        {
          principles.map((item) => (
            <>
              <dt>{item.term}</dt>
              <dd>{item.desc}</dd>
            </>
          ))
        }
      </dl>

      <div class="note note--warn">
        <p class="note__title">이럴 때는 진단보다 안전이 먼저입니다</p>
        <p>
          타는 냄새, 연기, 스파크, 반복적인 차단기 작동, 감전 위험, 가스 냄새 등이 있다면 진단을
          계속하기보다 사용을 중지하고 공식 서비스 또는 자격 있는 전문가에게 점검을 요청하세요.
        </p>
      </div>

      <p class="trust-panel__actions">
        <a class="btn btn--secondary" href="/editorial-policy/">정보 작성 기준 보기</a>
        <a class="btn btn--secondary" href="/safety/">안전 안내 보기</a>
      </p>
    </div>
  </section>

  {
    /* ⑤ 실제 가이드 콘텐츠.
       글이 있을 때만 노출한다. Phase 1 에서는 렌더링되지 않는다. */
    guides.length > 0 && (
      <section class="container section" aria-labelledby="common-symptoms">
        <h2 id="common-symptoms">사람들이 자주 겪는 증상</h2>
        <div class="grid grid--2">
          {guides.slice(0, 6).map((guide) => (
            <a
              class="card card-link"
              href={`/${guide.data.product}/${guide.data.slug ?? guide.id}/`}
            >
              <h3>{guide.data.title}</h3>
              <p class="muted">{guide.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
