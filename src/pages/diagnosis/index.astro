---
import PageLayout from '../../layouts/PageLayout.astro';
import Sources from '../../components/Sources.astro';
import { getCollection } from 'astro:content';
import { PRODUCT_FLOWS, LEVEL_META } from '../../data/diagnosis';
import { COMMON_SOURCES } from '../../data/sources';

// Phase 2 가이드가 생기면 결과 화면의 "관련 가이드"에 자동으로 연결된다.
const guides = await getCollection('guides', ({ data }) => !data.draft);
const relatedGuides = guides.map((g) => ({
  title: g.data.title,
  summary: g.data.summary,
  product: g.data.product,
  symptom: g.data.symptom,
  url: `/${g.data.product}/${g.data.slug ?? g.id}/`,
}));

const levels: { level: keyof typeof LEVEL_META; meaning: string }[] = [
  { level: 'SELF_CHECK', meaning: '사용자가 안전하게 확인할 수 있는 범위로 보입니다.' },
  { level: 'MONITOR', meaning: '조치한 뒤 같은 증상이 다시 나타나는지 확인이 필요합니다.' },
  {
    level: 'SERVICE_RECOMMENDED',
    meaning: '자가 확인 범위를 넘어설 가능성이 있어 전문 점검을 권합니다.',
  },
  { level: 'STOP_USE', meaning: '안전과 직접 관련된 신호이므로 사용을 멈춰야 합니다.' },
];
---

<PageLayout
  title="고장 진단 — 기사 부르기 전 확인 순서"
  description="세탁기·에어컨·냉장고 증상을 선택하면 안전 확인, 사용자가 직접 볼 수 있는 항목, 서비스가 필요한 기준, 비용 위험을 순서대로 정리해 드립니다."
  h1="고장 진단"
  lead="이 도구는 고장 부품을 맞히는 것이 목적이 아닙니다. 지금 무엇을 먼저 확인하고, 서비스를 불러야 하는 상황인지 판단하는 데 필요한 순서를 정리합니다."
  crumbs={[{ label: '고장 진단' }]}
>
  <div class="note note--info">
    <p class="note__title">진행 순서</p>
    <p>
      안전 확인 → 제품 선택 → 증상 선택 → 3~5개의 확인 질문 → 결과. 홈에서 제품과 증상을 이미
      고르셨다면 안전 확인을 마친 뒤 질문부터 시작합니다. 중간에 언제든 이전으로 돌아갈 수 있고,
      입력한 내용은 서버로 전송되거나 저장되지 않습니다.
    </p>
  </div>

  <div class="wizard" id="wizard" tabindex="-1" aria-live="polite">
    <p>진단 도구를 불러오는 중입니다.</p>
  </div>

  <noscript>
    <div class="note note--warn">
      <p class="note__title">진단 도구는 자바스크립트가 필요합니다</p>
      <p>
        브라우저에서 자바스크립트를 사용할 수 없는 환경이라면, 아래 페이지에서 같은 내용을
        글로 확인하실 수 있습니다.
      </p>
      <ul>
        <li><a href="/safety/">안전 안내 — 즉시 사용을 중지해야 하는 신호</a></li>
        {PRODUCT_FLOWS.map((p) => (
          <li>
            <a href={p.href}>{p.label} — 확인 범위와 서비스 기준</a>
          </li>
        ))}
      </ul>
    </div>
  </noscript>

  <h2>결과는 네 가지로 나뉩니다</h2>
  <p>
    같은 증상이라도 모델과 사용 환경에 따라 원인이 다를 수 있습니다. 그래서 이 도구는 고장
    부품을 단정하지 않고, 다음에 취할 행동을 네 등급으로만 구분합니다.
  </p>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th scope="col">결과</th>
          <th scope="col">의미</th>
        </tr>
      </thead>
      <tbody>
        {
          levels.map((row) => (
            <tr>
              <th scope="row">{LEVEL_META[row.level].kicker}</th>
              <td>{row.meaning}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>이 도구가 하지 않는 것</h2>
  <ul class="x-list">
    <li>고장 부품을 단정해서 알려주지 않습니다.</li>
    <li>근거 없이 만든 수리비 금액을 제시하지 않습니다.</li>
    <li>분해, 배선, 냉매, 가스 계통 작업 방법을 안내하지 않습니다.</li>
    <li>수리 업체를 중개하거나 특정 업체를 추천하지 않습니다.</li>
  </ul>

  <h2>입력한 내용은 어떻게 처리되나요</h2>
  <p>
    진단 과정에서 선택한 항목은 브라우저 안에서만 사용되며 서버로 전송되거나 저장되지
    않습니다. 개인을 식별할 수 있는 정보를 묻지 않으며, 결과 화면은 개인 입력에 따라 달라지는
    화면이므로 검색엔진 색인 대상에서 제외하고 있습니다. 자세한 내용은
    <a href="/privacy/">개인정보처리방침</a>에서 확인하실 수 있습니다.
  </p>

  <p>
    진단은 <a href="/editorial-policy/">정보 작성 기준</a>에 따라 작성되었으며, 안전과 관련된
    판단은 <a href="/safety/">안전 안내</a>와 같은 기준을 사용합니다.
  </p>

  <Sources
    sources={COMMON_SOURCES}
    note="진단 질문과 확인 항목은 아래 자료에서 사용자가 직접 확인하도록 안내하는 범위를 기준으로 구성했습니다. 모델별 정확한 조치는 해당 제품의 설명서와 제조사 고객지원이 우선합니다."
  />

  <script type="application/json" id="related-guides-data" set:html={JSON.stringify(relatedGuides)} is:inline />
  <script>
    import '../../scripts/diagnosis-wizard';
  </script>
</PageLayout>
