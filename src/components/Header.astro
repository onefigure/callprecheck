---
import { MAIN_NAV, SITE } from '../consts';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__bar">
    <a class="brand" href="/" aria-label={`${SITE.name} 홈으로`}>
      <span class="brand__ko">{SITE.name}</span>
      <span class="brand__en">{SITE.nameEn}</span>
    </a>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="site-nav"
      data-nav-toggle
    >
      메뉴
    </button>
  </div>
  <nav class="container" aria-label="주요 메뉴">
    <div class="site-nav" id="site-nav" data-open="false">
      <ul>
        {
          MAIN_NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.getElementById('site-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.dataset.open === 'true';
      nav.dataset.open = String(!open);
      toggle.setAttribute('aria-expanded', String(!open));
    });
  }
</script>
