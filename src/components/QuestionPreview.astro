---
import { PRODUCT_FLOWS } from '../data/diagnosis';

/**
 * 홈 히어로의 진단 질문 화면.
 *
 * 목업이 아니라 실제로 동작한다. 선택지를 누르면 그 답을 그대로 들고
 * /diagnosis/ 로 이동하며, 안전 확인(Step 0)을 거친 뒤 남은 질문부터 이어진다.
 * 홈에서는 최대 2개 질문까지만 다루고 진단을 끝내지 않는다.
 *
 * 제품 선택기(SymptomPicker)의 탭과 연동되어 선택한 제품의 질문이 보인다.
 * 자바스크립트가 없으면 세 제품이 모두 세로로 보이고 링크도 그대로 동작한다.
 */
const previews = PRODUCT_FLOWS.map((product) => ({
  product,
  symptom: product.symptoms[0],
})).filter((item) => item.symptom);
---

<div class="qpreview-group" data-preview-group data-enhanced="false">
  {
    previews.map(({ product, symptom }) => (
      <div class="qpreview" data-preview={product.id}>
        <p class="qpreview__title">
          {product.label} · {symptom.label}
        </p>

        {symptom.questions.slice(0, 2).map((question) => (
          <div class="qpreview__q">
            <p class="qpreview__question">{question.text}</p>
            <p class="qpreview__options">
              {question.options.map((option) => (
                <a
                  class="qpreview__option"
                  href={`/diagnosis/?product=${product.id}&symptom=${symptom.id}&a_${question.id}=${option.id}`}
                  data-preview-answer
                  data-preview-product={product.id}
                  data-preview-symptom={symptom.id}
                >
                  {option.label}
                </a>
              ))}
            </p>
          </div>
        ))}

        <p class="qpreview__note">
          답을 고르면 안전 확인을 거쳐 남은 질문으로 이어집니다. 몇 가지 질문으로 먼저 확인할 수
          있는 문제인지 판단합니다.
        </p>
      </div>
    ))
  }
</div>

<script>
  document
    .querySelectorAll<HTMLAnchorElement>('[data-preview-answer]')
    .forEach((link) => {
      link.addEventListener('click', () => {
        window.cpTrack('symptom_selected', {
          product: link.dataset.previewProduct ?? '',
          symptom: link.dataset.previewSymptom ?? '',
          source: 'home_preview',
        });
      });
    });
</script>
